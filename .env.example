# ╔══════════════════════════════════════════════════════════════╗
# ║         EvoTrade AI — Full Environment Configuration         ║
# ╚══════════════════════════════════════════════════════════════╝
# ── QUICK START: TUNE THESE FIRST ─────────────────────────────────────────────
# 1) LLM_PROVIDER=gemini|openai|anthropic|ollama
# 2) GEMINI_API_KEY=... (or OPENAI_API_KEY / ANTHROPIC_API_KEY)
# 3) PAPER_TRADING=true
# 4) INITIAL_CAPITAL=100.0
# 5) MAX_RISK_PER_TRADE=0.02
# 6) MIN_TRADE_CONFIDENCE=0.60
# 7) TRADE_COOLDOWN_SECONDS=14400
# Copy this file to .env and fill in your keys.
# A real LLM provider + API key is required (or use Ollama locally).

# ── LLM PROVIDER (required — no mock/demo mode) ─────────────────────────────
LLM_PROVIDER=gemini

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── EXCHANGE / MARKET DATA ────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_SECRET=
USE_TESTNET=true

# ── TRADING MODE (swing — 4h holds) ─────────────────────────────────────────
PAPER_TRADING=true
INITIAL_CAPITAL=100.0
MAX_RISK_PER_TRADE=0.02
MAX_DRAWDOWN_KILL=0.10
DEFAULT_STOP_LOSS_PCT=0.025
DEFAULT_TAKE_PROFIT_PCT=0.075

MIN_TRADE_CONFIDENCE=0.60
TRADE_COOLDOWN_SECONDS=14400
LIVE_AUTO_APPROVE_CONFIDENCE=0.80

ADAPTIVE_TRADE_CONFIDENCE=false
ADAPTIVE_CONFIDENCE_WINDOW=15
ADAPTIVE_CONFIDENCE_STEP=0.03
ADAPTIVE_CONFIDENCE_MIN_FLOOR=0.45
ADAPTIVE_CONFIDENCE_MAX_CEIL=0.75

# ── ENGINE SETTINGS ───────────────────────────────────────────────────────────
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=4h
ENGINE_INTERVAL_SECONDS=3600
EVOLUTION_INTERVAL_HOURS=6
AUTO_START_ENGINE=true

# ── SYSTEM ───────────────────────────────────────────────────────────────────
DB_PATH=data/evotrade.duckdb
LOG_LEVEL=INFO
LOG_FILE=data/evotrade.log
