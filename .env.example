# ╔══════════════════════════════════════════════════════════════╗
# ║         EvoTrade AI — Full Environment Configuration         ║
# ╚══════════════════════════════════════════════════════════════╝
# ── QUICK START: TUNE THESE FIRST ─────────────────────────────────────────────
# 1) LLM_PROVIDER=mock|gemini|openai|anthropic|ollama
# 2) GEMINI_API_KEY=... (or OPENAI_API_KEY / ANTHROPIC_API_KEY)
# 3) PAPER_TRADING=true
# 4) INITIAL_CAPITAL=100.0
# 5) MAX_RISK_PER_TRADE=0.02
# 6) MIN_TRADE_CONFIDENCE=0.60
# 7) MAX_OPEN_TRADES_TOTAL=3
# 8) TRADE_COOLDOWN_SECONDS=300
# Copy this file to .env and fill in your keys.
# The engine runs in DEMO MODE (mock LLM + synthetic data)
# with NO keys at all — safe to try immediately.

# ── LLM PROVIDER ─────────────────────────────────────────────────────────────
# Pick ONE provider. Set to "mock" for demo (no key needed).
# Options: mock | anthropic | openai | gemini | ollama
LLM_PROVIDER=mock

# Anthropic Claude  →  https://console.anthropic.com/  (Settings → API Keys)
ANTHROPIC_API_KEY=
# Model options: claude-sonnet-4-20250514 | claude-opus-4-20250514 | claude-haiku-4-5-20251001
LLM_MODEL=claude-sonnet-4-20250514

# OpenAI GPT-4o  →  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini  →  https://aistudio.google.com/app/apikey  ← FREE tier available!
# Free: 15 requests/min, 1 million tokens/day on gemini-2.0-flash
GEMINI_API_KEY=AIzaSyA2s3SXYmHVRcoc9Uv1Nf6OdurjlvFoVKc
# Model options: gemini-2.0-flash (fast, free) | gemini-1.5-pro (capable)
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local, no key needed)  →  https://ollama.com/download
# After installing: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── EXCHANGE / MARKET DATA ────────────────────────────────────────────────────
# Binance API  →  https://www.binance.com/en/my/settings/api-management
# NOTE: OHLCV market data (candlestick charts) is PUBLIC — no key needed!
# Keys are only required for LIVE/TESTNET order placement.
BINANCE_API_KEY=GTfrCheSbk72XZiMP2VaxJvJQIrpa9ttH8IKXTqgERxFymznh0Hicm91aflK44yN
BINANCE_SECRET=4FlcYyYTuwrTrYsojK1zS1HetIKdBRCj2MDO1YST29mBKPq5FtytHc689TCWCLEU
# true = use Binance Testnet (fake money, real market data)
USE_TESTNET=true

# ── TRADING MODE ──────────────────────────────────────────────────────────────
# ALWAYS start with PAPER_TRADING=true (simulates trades, no real money)
PAPER_TRADING=true
INITIAL_CAPITAL=100.0
MAX_RISK_PER_TRADE=0.02     # 2% of equity per trade
MAX_DRAWDOWN_KILL=0.10      # Kill switch at 10% portfolio drawdown

# Min confidence (0–1) for BUY/SELL to reach execution (graph + execution agent)
MIN_TRADE_CONFIDENCE=0.60
MAX_OPEN_TRADES_TOTAL=3
MAX_OPEN_TRADES_PER_SYMBOL=1
TRADE_COOLDOWN_SECONDS=300
# Live/testnet (non-paper): auto-approve human review at this confidence or higher
LIVE_AUTO_APPROVE_CONFIDENCE=0.80

# Nudge MIN_TRADE_CONFIDENCE each cycle from last ADAPTIVE_CONFIDENCE_WINDOW closed trades
ADAPTIVE_TRADE_CONFIDENCE=false
ADAPTIVE_CONFIDENCE_WINDOW=15
ADAPTIVE_CONFIDENCE_STEP=0.03
ADAPTIVE_CONFIDENCE_MIN_FLOOR=0.45
ADAPTIVE_CONFIDENCE_MAX_CEIL=0.75

# ── ENGINE SETTINGS ───────────────────────────────────────────────────────────
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1h
ENGINE_INTERVAL_SECONDS=30  # How often the trading cycle runs
EVOLUTION_INTERVAL_HOURS=6  # How often auto-evolution runs
AUTO_START_ENGINE=true

# ── SYSTEM ───────────────────────────────────────────────────────────────────
DB_PATH=data/evotrade.duckdb
LOG_LEVEL=INFO
LOG_FILE=data/evotrade.log
