# ╔══════════════════════════════════════════════════════════════╗
# ║         EvoTrade AI — Full Environment Configuration         ║
# ╚══════════════════════════════════════════════════════════════╝
# ── QUICK START: TUNE THESE FIRST ─────────────────────────────────────────────
# 1) LLM_PROVIDER=mock|gemini|openai|anthropic|ollama
# 2) GEMINI_API_KEY=... (or OPENAI_API_KEY / ANTHROPIC_API_KEY)
# 3) PAPER_TRADING=true
# 4) INITIAL_CAPITAL=100.0
# 5) MAX_RISK_PER_TRADE=0.02
# 6) MIN_TRADE_CONFIDENCE=0.60
# 7) MAX_OPEN_TRADES_TOTAL=3
# 8) TRADE_COOLDOWN_SECONDS=300
# Copy this file to .env and fill in your keys.
# The engine runs in DEMO MODE (mock LLM + synthetic data)
# with NO keys at all — safe to try immediately.

# ── LLM PROVIDER ─────────────────────────────────────────────────────────────
# Pick ONE provider. Set to "mock" for demo (no key needed).
# Options: mock | anthropic | openai | gemini | ollama
LLM_PROVIDER=mock

# Anthropic Claude  →  https://console.anthropic.com/  (Settings → API Keys)
ANTHROPIC_API_KEY=
# Model options: claude-sonnet-4-20250514 | claude-opus-4-20250514 | claude-haiku-4-5-20251001
LLM_MODEL=claude-sonnet-4-20250514

# OpenAI GPT-4o  →  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini  →  https://aistudio.google.com/app/apikey  ← FREE tier available!
# Free: 15 requests/min, 1 million tokens/day on gemini-2.0-flash
GEMINI_API_KEY=
# Model options: gemini-2.0-flash (fast, free) | gemini-1.5-pro (capable)
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local, no key needed)  →  https://ollama.com/download
# After installing: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── EXCHANGE / MARKET DATA ────────────────────────────────────────────────────
# Binance API  →  https://www.binance.com/en/my/settings/api-management
# NOTE: OHLCV market data (candlestick charts) is PUBLIC — no key needed!
# Keys are only required for LIVE/TESTNET order placement.
BINANCE_API_KEY=GTfrCheSbk72XZiMP2VaxJvJQIrpa9ttH8IKXTqgERxFymznh0Hicm91aflK44yN
BINANCE_SECRET=4FlcYyYTuwrTrYsojK1zS1HetIKdBRCj2MDO1YST29mBKPq5FtytHc689TCWCLEU
# true = use Binance Testnet (fake money, real market data)
USE_TESTNET=true

# ── TRADING MODE ──────────────────────────────────────────────────────────────
# ALWAYS start with PAPER_TRADING=true (simulates trades, no real money)
PAPER_TRADING=true
INITIAL_CAPITAL=100.0
MAX_RISK_PER_TRADE=0.02     # 2% of equity per trade
MAX_DRAWDOWN_KILL=0.10      # Kill switch at 10% portfolio drawdown

# Min confidence (0–1) for BUY/SELL to reach execution (graph + execution agent)
MIN_TRADE_CONFIDENCE=0.60
MAX_OPEN_TRADES_TOTAL=3
MAX_OPEN_TRADES_PER_SYMBOL=1
TRADE_COOLDOWN_SECONDS=300
# Live/testnet (non-paper): auto-approve human review at this confidence or higher
LIVE_AUTO_APPROVE_CONFIDENCE=0.80

# Nudge MIN_TRADE_CONFIDENCE each cycle from last ADAPTIVE_CONFIDENCE_WINDOW closed trades
ADAPTIVE_TRADE_CONFIDENCE=false
ADAPTIVE_CONFIDENCE_WINDOW=15
ADAPTIVE_CONFIDENCE_STEP=0.03
ADAPTIVE_CONFIDENCE_MIN_FLOOR=0.45
ADAPTIVE_CONFIDENCE_MAX_CEIL=0.75

# ── ENGINE SETTINGS ───────────────────────────────────────────────────────────
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1h
ENGINE_INTERVAL_SECONDS=30  # How often the trading cycle runs
EVOLUTION_INTERVAL_HOURS=6  # How often auto-evolution runs
AUTO_START_ENGINE=true

# ── SCALPING MODE ─────────────────────────────────────────────────────────────
# Enable intraday scalping engine (rule-based, no LLM, 1m-5m timeframes)
SCALPING_MODE=false

# Short timeframe for scalp data: "1m" | "3m" | "5m"
SCALPING_TIMEFRAME=5m

# Comma-separated symbols to scalp (cycles through each)
SCALPING_SYMBOLS=BTC/USDT

# Your scalping account size in USDT (used for all risk calculations)
SCALPING_ACCOUNT_SIZE=1000.0

# Hard daily loss limit as % of account (0.03 = 3%).  Engine kills trading when hit.
SCALPING_MAX_DAILY_LOSS_PCT=0.03

# Target risk per trade as % of account (0.005 = 0.5% = $5 on a $1000 account)
SCALPING_RISK_PER_TRADE_PCT=0.005

# Max single position size as % of account (0.25 = 25% = $250 on $1000 account)
SCALPING_MAX_POSITION_PCT=0.25

# Maximum trades per UTC day (anti-overtrading guard)
SCALPING_MAX_TRADES_PER_DAY=20

# How often the scalping cycle checks for setups (seconds, min 15)
SCALPING_INTERVAL_SECONDS=30

# Minimum SL floor as % of entry price.  ATR-derived SL will never go below this (0.002 = 0.2%)
SCALPING_SL_PCT=0.002

# Take-profit = actual SL distance × this multiplier.  1.5 = 1:1.5 RR
SCALPING_TP_MULTIPLIER=1.5

# ATR multiplier for dynamic stop-loss:  SL_dist = max(ATR × mult, price × SL_PCT)
# Setup-level tuning: breakout 0.8×, pullback 1.0×, VWAP reversion 1.2×, RSI extreme 1.5×
SCALPING_ATR_SL_MULT=0.8

# Use LLM (Gemini/OpenAI/etc) as the final scalping decision-maker.
# Rules still run and act as fallback/guardrails.
SCALPING_USE_LLM=true

# LLM final authority:
# true  -> LLM BUY/SELL can execute even if no rule setup qualifies
# false -> require at least one rule-supported directional setup
SCALPING_LLM_FINAL_AUTHORITY=true

# Anti-churn controls (recommended with LLM mode):
# Require same BUY/SELL signal for N consecutive cycles before entry.
SCALPING_SIGNAL_CONFIRMATION_CYCLES=2
# Prevent immediate direction flips (BUY->SELL or SELL->BUY) for this many seconds.
SCALPING_REVERSAL_COOLDOWN_SECONDS=120

# Auto timeframe selection — engine evaluates all options and picks the cleanest signal
SCALPING_TF_AUTO=true

# Timeframes to evaluate each cycle (comma-separated, fastest first)
SCALPING_TF_OPTIONS=1m,3m,5m

# Skip a timeframe if its ATR/price ratio exceeds this (too noisy to trade cleanly)
# 0.015 = 1.5% — typical cutoff above which 1m becomes random noise
SCALPING_TF_NOISE_FILTER=0.015

# Minimum setup confidence (0-1) before a scalp fires.  Lower = more trades, lower quality
SCALPING_MIN_CONFIDENCE=0.55

# Force-close all positions at end of scalping day
SCALPING_EOD_CLOSE_ALL=true

# UTC hour to trigger end-of-day close-all (23 = 11 PM UTC)
SCALPING_EOD_HOUR_UTC=23

# ── SWING TRADING MODE (4h chart patterns) ───────────────────────────────────
# Multi-day swing engine — scans ALL chart patterns on 4h candles
SWING_MODE=false
SWING_TIMEFRAME=4h
SWING_SYMBOLS=BTC/USDT
SWING_ACCOUNT_SIZE=1000.0
SWING_MAX_WEEKLY_LOSS_PCT=0.05
SWING_RISK_PER_TRADE_PCT=0.01
SWING_MAX_POSITION_PCT=0.30
SWING_MAX_TRADES_PER_WEEK=5
SWING_INTERVAL_SECONDS=3600
SWING_SL_PCT=0.015
SWING_TP_MULTIPLIER=3.0
SWING_ATR_SL_MULT=2.0
SWING_USE_LLM=true
SWING_LLM_FINAL_AUTHORITY=true
SWING_SIGNAL_CONFIRMATION_CYCLES=1
SWING_MIN_CONFIDENCE=0.58
SWING_OHLCV_LIMIT=300

# ── SYSTEM ───────────────────────────────────────────────────────────────────
DB_PATH=data/evotrade.duckdb
LOG_LEVEL=INFO
LOG_FILE=data/evotrade.log
